{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/navigation/**",
              "components/sections/**",
              "slides/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClaimBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:claim|image|alt|key|ref|className|style|children)$/]",
        "message": "<ClaimBand> doesn't accept that prop. Declared props: claim, image, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactRoute'] > JSXAttribute > JSXIdentifier[name!=/^(?:subject|hint|href|key|ref|className|style|children)$/]",
        "message": "<ContactRoute> doesn't accept that prop. Declared props: subject, hint, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaClose'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|heading|ctaLabel|ctaHref|phone|phoneHref|key|ref|className|style|children)$/]",
        "message": "<CtaClose> doesn't accept that prop. Declared props: theme, heading, ctaLabel, ctaHref, phone, phoneHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|href|external|cta|key|ref|className|style|children)$/]",
        "message": "<EntryCard> doesn't accept that prop. Declared props: title, meta, href, external, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|big|key|ref|className|style|children)$/]",
        "message": "<FactRow> doesn't accept that prop. Declared props: label, value, big."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='FootLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<FootLink> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grade'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|className|key|ref|className|style|children)$/]",
        "message": "<Grade> doesn't accept that prop. Declared props: level, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InstitutionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|url|cta|key|ref|className|style|children)$/]",
        "message": "<InstitutionCard> doesn't accept that prop. Declared props: name, role, url, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|heading|lead|icon|align|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: eyebrow, heading, lead, icon, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<PageHero> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|ghost|small|external|block|className|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: href, label, ghost, small, external, block, className, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublicationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|title|authors|journal|href|grade|key|ref|className|style|children)$/]",
        "message": "<PublicationRow> doesn't accept that prop. Declared props: year, title, authors, journal, href, grade."
      },
      {
        "selector": "JSXOpeningElement[name.name='TalkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|abstract|meta|topicName|image|alt|href|cta|key|ref|className|style|children)$/]",
        "message": "<TalkCard> doesn't accept that prop. Declared props: title, abstract, meta, topicName, image, alt, href, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|name|summary|theme|href|more|key|ref|className|style|children)$/]",
        "message": "<TopicCard> doesn't accept that prop. Declared props: slug, name, summary, theme, href, more."
      },
      {
        "selector": "JSXOpeningElement[name.name='WebinarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|when|duration|price|href|cta|key|ref|className|style|children)$/]",
        "message": "<WebinarCard> doesn't accept that prop. Declared props: title, when, duration, price, href, cta."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
